# Leave DATABASE_URL empty to run as a demo with made-up data (in-memory, resets on restart).
# Set it (e.g. Neon via Vercel Storage) to run for real.
DATABASE_URL=

# Required when running for real
ADMIN_PASSWORD=choose-a-good-password
SESSION_SECRET=a-long-random-string-of-at-least-32-characters

# Optional: email confirmations, reminders and booking notifications.
# Works with e.g. a Gmail account and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: an extra address for booking notifications (SMTP_USER always gets them).
ADMIN_EMAIL=

# Optional: protects the reminder cron endpoint (Vercel sends it automatically).
CRON_SECRET=
